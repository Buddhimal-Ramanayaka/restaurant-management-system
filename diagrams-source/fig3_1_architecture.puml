@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #666666
}
skinparam package {
  BorderColor #999999
  FontSize 13
}
title System Architecture - Three-Tier Layered Architecture with WebSocket Event Layer

package "Presentation Layer  (React 19.x + Tailwind CSS 3.x)" #E3F2FD {
  component "POS Terminal\n(Waiter)" as POS
  component "KOT Kitchen Display\n(Kitchen Staff)" as KDS
  component "Billing Terminal\n(Cashier)" as BILL
  component "Manager Dashboard" as MGR
  component "Admin Panel" as ADM
  component "Axios HTTP client\n(JWT Bearer interceptor)" as AX
  component "SockJS + STOMP client\n(auto-reconnect)" as WS
}

package "Application Layer  (Spring Boot 3.4.1 / Java 21)" #E8F5E9 {
  component "REST Controllers\n(no business logic)" as CTRL
  component "Service Layer\n(business rules)" as SVC
  component "RecipeDeductionService\n(core engine)" as RDS
  component "OrderEventPublisher\n(single outbound point)" as OEP
  component "STOMP SimpleBroker" as BROKER
  component "Spring Security\nJWT filter + RBAC" as SEC
  component "AOP Audit Aspect\n(@AuditableAction)" as AOP
}

package "Data Layer  (MySQL 8.0 InnoDB)" #FFF3E0 {
  component "Spring Data JPA\nrepositories" as JPA
  component "HikariCP pool\n(max 15 connections)" as HIKARI
  database "rms_db\n20 normalised tables\nrow-level locking" as DB
}

POS --> AX
KDS --> AX
BILL --> AX
MGR --> AX
ADM --> AX
POS --> WS
KDS --> WS
MGR --> WS

AX --> SEC : HTTPS + JWT
SEC --> CTRL
WS --> BROKER : STOMP CONNECT\n(JWT validated)
CTRL --> SVC
SVC --> RDS
SVC --> OEP
RDS --> OEP
OEP --> BROKER
AOP ..> SVC : intercepts
SVC --> JPA
RDS --> JPA
JPA --> HIKARI
HIKARI --> DB

note right of BROKER
  Five destinations:
  /topic/kitchen        kitchen-wide broadcasts
  /topic/tables         floor-plan state changes
  /topic/alerts/stock   inventory thresholds
  /topic/menu           live menu availability
  /user/{name}/queue/order-ready
                        point-to-point to waiter
end note

note bottom of DB
  InnoDB row-level locking backs the
  pessimistic write locks taken by
  IngredientRepository and
  RestaurantTableRepository.
end note

@enduml
