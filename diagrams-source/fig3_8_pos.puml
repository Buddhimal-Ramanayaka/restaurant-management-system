@startsalt
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
title POS Terminal - Item Grid, Category Tabs, Cart Panel and Order Summary
{
  {* RMS | POS Terminal | <b>waiter (WAITER) | Log out }
  {
    {+
      {/ <b>Shovel | Noodles | Salad | Fried Rice | Kottu | Sri Lankan Curry | ... }
      {
        {^"Rice Kottu Shovel (Chicken)"
          Shovel
          <b>LKR 3000.00
          <color:green>Available</color>
          [ Add to Cart ]
        } |
        {^"Chicken Kottu"
          Kottu
          <b>LKR 1200.00
          <color:green>Available</color>
          [ Add to Cart ]
        } |
        {^"Crab Curry"
          Sri Lankan Curry
          <b>LKR 3000.00
          <color:gray>Unavailable</color>
          [ Add to Cart ]
        }
      }
      ~~ dimmed card + disabled button when unavailable ~~
    } |
    {^"Order Cart          Table: T-03"
      {
        Rice Kottu Shovel (Chicken) | [ - ] | 1 | [ + ]
        LKR 3000.00 each            | .     | . | .
      }
      "Special note: no spicy, extra rice   "
      --
      "Customer phone (CRM lookup)  " | [ Search ]
      <color:green>Nadeeka Fernando - GOLD - 12 visits</color>
      --
      {
        Subtotal                | LKR 3000.00
        <color:green>Gold Tier 10% Off</color> | <color:green>-LKR 300.00</color>
        Service Charge (10%)    | LKR 270.00
        VAT (8%)                | LKR 237.60
        <b>Total                | <b>LKR 3207.60
      }
      --
      [ Clear Cart ] | [ <b>Send to Kitchen ]
    }
  }
}
@endsalt
