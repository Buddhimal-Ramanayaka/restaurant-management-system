@startuml
' Figure 3.7 - Activity Diagram, Complete Order Fulfilment Workflow
'
' Theme follows the original figure: four coloured swimlanes, rounded actions, diamond
' decisions, red failure branches.
'
' Sizing: each lane is as wide as its own widest node, and the four lane widths add up,
' so every label is kept short and wrapped rather than run on. Sequential steps in one
' lane are merged where they describe a single user action - each node removed saves its
' padding and its incoming arrow.
'
' Two PlantUML notes, both learned the hard way on this figure:
'   - "#COLOR:text;" is deprecated in this version. It prints a warning banner into the
'     image AND swallows every following line into the node label. The supported form is
'     ":text; <<#COLOR>>".
'   - "partition" draws its box across every swimlane it touches, so the transaction
'     boundary is carried by a note instead.
'
' Verified against PosPage.jsx (table selection is client-side state only),
' OrderService.submitOrder, RecipeDeductionService.deductForOrder /
' handlePostDeductionThresholds, InventoryAlertService, TableService and BillingService.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam defaultFontSize 21
skinparam ArrowThickness 1.5
skinparam ArrowColor #37474F

skinparam activity {
  FontSize 21
  BorderThickness 1.6
  BackgroundColor #FFFFFF
  BorderColor #546E7A
  DiamondBackgroundColor #FFF8E1
  DiamondBorderColor #F9A825
  DiamondFontSize 20
  StartColor #212121
  EndColor #212121
}
skinparam swimlane {
  BorderColor #90A4AE
  BorderThickness 1.6
  TitleFontSize 23
  TitleFontStyle bold
}
skinparam note {
  FontSize 19
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}

title
Activity Diagram — Complete Order Fulfilment Workflow
<size:10> </size>
end title

|#E3F2FD|Waiter (POS)|
start
:Log in, select a table
<i>client-side only,</i>
<i>nothing locked yet</i>;
:Add items, notes,
customer lookup,
submit order;

|#E8F5E9|System (Backend)|
:Lock table row
SELECT … FOR UPDATE;
if (Table AVAILABLE?) then (no)
  :409 — table busy; <<#FFCDD2>>
  stop
else (yes)
endif
:Set OCCUPIED, resolve customer;
if (All items available?) then (no)
  :409 — item off menu; <<#FFCDD2>>
  stop
else (yes)
endif
:<b>Recipe Deduction</b>
sum per ingredient,
lock rows asc. id;
if (Stock sufficient?) then (no)
  :409 — short stock,
  order rolls back; <<#FFCDD2>>
  stop
else (yes)
endif
:Deduct stock, append ledger,
disable zero items,
raise reorder event,
persist PENDING, broadcast KOT;
:Commit. Async after:
draft PO, alert mgr;

|#FFF8E1|Kitchen Staff|
:Receive KOT,
tap Start → PREPARING,
mark lines ready,
order READY;

|#E3F2FD|Waiter (POS)|
:Order-ready alert;

|#FCE4EC|Cashier|
:Open shift, issue bill
VAT + service charge;
if (Manual discount?) then (yes)
  :Re-verify Manager;
else (no)
endif
:Payment → COMPLETED,
table → CLEANING;
stop

@enduml
