@startuml
' Figure 2.1 - Use Case Diagram, Restaurant Management System
'
' Plain UML notation: stick-figure actors, unfilled use case ellipses, a solid
' system boundary, black association lines. No per-actor colour coding and no
' custom palette - the examiner flagged the previous figures as reading like AI
' output, and the colour scheme was the largest part of that impression.
' Distinction between actors now comes from position and association alone,
' which is what standard UML relies on.
'
' Layout is unchanged because it works: two invisible grouping rectangles pin the
' use cases into two columns and keep each actor's block contiguous. Admin,
' Waiter and Cashier sit left against the left column; Manager and Kitchen Staff
' right against the right column, Manager declared first so it resolves to the
' top-right corner. Every association therefore stays inside its own half of the
' canvas and none of them cross.
'
' Verified against SecurityConfig.java authorisation rules and the controller surface.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam defaultFontSize 26
skinparam nodesep 8
skinparam ranksep 58
skinparam ArrowThickness 1.2
skinparam ArrowColor #000000

' Explicit black-on-white rather than `skinparam monochrome true`: monochrome mode
' forces a grey fill and border onto the two invisible layout rectangles, which then
' show up as boxes around the columns.
skinparam actor {
  FontSize 26
  FontStyle bold
  BorderColor #000000
  BackgroundColor #FFFFFF
}
skinparam usecase {
  FontSize 26
  BorderThickness 1.2
  BorderColor #000000
  BackgroundColor #FFFFFF
  FontColor #000000
}
skinparam rectangle {
  FontSize 26
  FontStyle bold
  BorderThickness 1.4
  BorderColor #000000
  BackgroundColor #FFFFFF
  FontColor #000000
}
skinparam rectangle<<grp>> {
  BackgroundColor transparent
  BorderColor transparent
  FontColor transparent
  BorderThickness 0
}

title Use Case Diagram — Restaurant Management System

left to right direction

actor "Admin" as A
actor "Waiter" as W
actor "Cashier" as C

rectangle "Restaurant Management System" {

  rectangle " " <<grp>> as G1 {
    usecase "Authenticate\n(Login)"          as UX

    usecase "Manage Users\n& Roles"          as UA1
    usecase "Manage Suppliers"               as UA4
    usecase "Configure\nBilling Rates"       as UA5

    usecase "View Table\nFloor Plan"         as UW1
    usecase "Open POS Session\non Table"     as UW2
    usecase "Add / Remove\nOrder Items"      as UW3
    usecase "Submit Order\nto Kitchen"       as UW4
    usecase "Register / Lookup\nCustomer"    as UW5
    usecase "Preview Loyalty\nDiscount"      as UW6
    usecase "Void Order"                     as UW7
    usecase "Receive Ready\nNotification"    as UW8

    usecase "Open / Close\nCashier Shift"    as UC1
    usecase "View Orders\nAwaiting Billing"  as UC2
    usecase "Generate &\nPrint Bill"         as UC3
    usecase "Apply Manual\nDiscount"         as UC4
    usecase "Settle Payment\n& Close Table"  as UC5
  }

  rectangle " " <<grp>> as G2 {
    usecase "View Operations\nDashboard"     as UM1
    usecase "Approve\nPurchase Orders"       as UM2
    usecase "Record Goods\nReceived (GRN)"   as UM3
    usecase "Approve Stock\nAdjustments"     as UM4
    usecase "Review Shift\nReports"          as UM5
    usecase "Manage Table\nReservations"     as UM6
    usecase "Log Waste /\nSpoilage"          as UM7
    usecase "Configure\nMenu Items"          as UM8
    usecase "Define Recipe\nMappings"        as UM9

    usecase "View KOT\nKanban Board"         as UK1
    usecase "Move Ticket\nto Preparing"      as UK2
    usecase "Mark Individual\nLines Ready"   as UK3
    usecase "Mark Order\nComplete / Ready"   as UK4
    usecase "Log Waste /\nKitchen Accident"  as UK5
  }

}

actor "Manager" as M
actor "Kitchen Staff" as K

' put G2 one rank to the right of G1 so the two blocks form two columns
UA1 -[hidden]- UM1
UC5 -[hidden]- UK5

' Manager first, so it takes the top of the right-hand rank
UM1 -- M
UM2 -- M
UM3 -- M
UM4 -- M
UM5 -- M
UM6 -- M
UM7 -- M
UM8 -- M
UM9 -- M

UK1 -- K
UK2 -- K
UK3 -- K
UK4 -- K
UK5 -- K

C -- UC1
C -- UC2
C -- UC3
C -- UC4
C -- UC5

A -- UA1
A -- UA4
A -- UA5

W -- UW1
W -- UW2
W -- UW3
W -- UW4
W -- UW5
W -- UW6
W -- UW7
W -- UW8

' every role authenticates before any use case - dashed, so it stays recessive
A .. UX
W .. UX
C .. UX
M .. UX
K .. UX

@enduml
