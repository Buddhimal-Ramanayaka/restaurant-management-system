@startsalt
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
title Manager Dashboard - KPI Cards, Stock Alerts, Revenue Chart and Purchase Order Approval
{
  {* RMS | Manager Dashboard | [ Log Waste ] | <b>manager (MANAGER) | Log out }
  {#
    TOTAL REVENUE | ORDERS TODAY | COGS | ACTIVE TABLES
    <b><size:15>LKR 47,300 | <b><size:15>127 | <b><size:15>LKR 18,920 | <b><size:15>6
  }
  {^"Revenue vs. COGS - Last 7 Days"
    {
      <b>[ grouped bar chart ]
      Seven day columns, Mon to Sun.
      Solid bar = revenue, hatched bar = COGS.
      Rendered client-side from GET /api/analytics/revenue-trend?days=7
    }
  }
  {^"Stock Alerts"
    {#
      Severity | Ingredient | Auto-drafted PO
      <color:red><b>OUT OF STOCK | Crab (0.00 remaining, reorder at 3.00) | [ Draft PO #7 awaiting approval ]
      <color:orange><b>LOW STOCK | Cheese (2.80 remaining, reorder at 3.00) | [ Draft PO #8 awaiting approval ]
    }
    Clicking an alert scrolls to and highlights that PO row below.
  }
  {^"Purchase Order Approvals - 2 awaiting action"
    {#
      PO | Supplier | Status | Value | Action
      PO-7 | Colombo Seafood Traders | Draft (auto-generated) | LKR 8,960 | [ Send for Approval ] [ Cancel ] [ PDF ]
      PO-8 | Ceylon Dairy & Provisions | Approved | LKR 3,400 | [ Mark Ordered ] [ Cancel ] [ PDF ]
    }
  }
  {^"Shift Reports"
    {#
      Cashier | Ended | System Cash | Declared | Variance | Reviewed by
      cashier | 16:18 | LKR 22,400.00 | LKR 22,500.00 | +LKR 100.00 | [ Mark Reviewed ]
    }
  }
}
@endsalt
