@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam ArrowColor #555555
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFF8E1
  BorderColor #E65100
  FontSize 12
}
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #BBBBBB
}
title Use Case Diagram - Restaurant Management System

top to bottom direction

actor "Waiter" as W
actor "Kitchen Staff" as K
actor "Cashier" as C
actor "Manager" as M
actor "Admin" as A

rectangle "Restaurant Management System" {

  package "Ordering" {
    usecase "Authenticate (JWT, role-based)" as UC0
    usecase "View Table Floor Plan" as UC1
    usecase "Open Table for Order" as UC2
    usecase "Browse Menu by Category" as UC3
    usecase "Add Items and Special Notes" as UC4
    usecase "Look Up Customer (CRM)" as UC5
    usecase "Submit Order to Kitchen" as UC6
    usecase "Void Order" as UC7
    usecase "Manage Reservations" as UC8
  }

  package "Kitchen" {
    usecase "View KOT Kanban Board" as UC9
    usecase "Start Cooking (line/order)" as UC10
    usecase "Mark Line or Order Ready" as UC11
    usecase "Log Ingredient Waste" as UC12
  }

  package "Billing" {
    usecase "Start / Close Shift" as UC13
    usecase "Generate Bill" as UC14
    usecase "Apply Manual Discount" as UC15
    usecase "Settle Payment" as UC16
    usecase "Export Bill as PDF" as UC17
  }

  package "Management" {
    usecase "View Dashboard KPIs" as UC18
    usecase "Monitor Stock Alerts" as UC19
    usecase "Approve Purchase Orders" as UC20
    usecase "Record GRN Receipt" as UC21
    usecase "Correct Stock (cycle count)" as UC22
    usecase "Review Shift Reports" as UC23
  }

  package "Administration" {
    usecase "Manage Users and Roles" as UC24
    usecase "Manage Menu and Recipes" as UC25
    usecase "Manage Suppliers" as UC26
    usecase "Configure Billing Rates" as UC27
  }
}

W --> UC0
K --> UC0
C --> UC0
M --> UC0
A --> UC0

W --> UC1
W --> UC2
W --> UC3
W --> UC4
W --> UC5
W --> UC6
W --> UC7
W --> UC8

K --> UC9
K --> UC10
K --> UC11
K --> UC12

C --> UC13
C --> UC14
C --> UC15
C --> UC16
C --> UC17

M --> UC18
M --> UC19
M --> UC20
M --> UC21
M --> UC22
M --> UC23
M --> UC8
M --> UC12

A --> UC24
A --> UC25
A --> UC26
A --> UC27

UC7 ..> UC0 : <<include>>\nmanager re-auth
UC15 ..> UC0 : <<include>>\nmanager re-auth
UC6 ..> UC19 : <<extend>>\nthreshold breach
UC20 ..> UC21 : <<extend>>\non delivery

note bottom of UC24
  Admin additionally inherits every
  Manager use case in this diagram.
end note

@enduml
